{
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-guestbook",
      "database_id": "1b07408c-36ce-440c-8fe9-225e70ab88e1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}